# Node 24+, persistent local disk. Optional for local sample use.
OPS_DB_PATH=.data/operations.sqlite
# Required before hosting: at least 32 random characters. Basic password or API Bearer token.
OPS_ACCESS_TOKEN=
# Optional extraction. Source text is sent to Anthropic only on operator request.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional authorized Gmail OAuth token with gmail.readonly scope; no refresh flow yet.
GMAIL_ACCESS_TOKEN=
GMAIL_ACCOUNT=
# Official Twilio WhatsApp inbound sandbox; exact HTTPS URL used for signatures.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_TO=
TWILIO_WEBHOOK_URL=
WHATSAPP_ENVIRONMENT=sandbox
# Optional provisioned Travefy platform/user access.
TRAVEFY_PUBLIC_KEY=
TRAVEFY_USER_TOKEN=
# Legacy prototype only; not needed for /operations.
DATABASE_URL=
DIRECT_URL=
VOYAGE_API_KEY=
# Destructive fictional seed opt-in for a dedicated demo database only:
# SEED_SYNTHETIC=1
